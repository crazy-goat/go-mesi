# Ignore binary and object files
*.o
*.lo
*.la
*.so
*.dll
*.dylib
*.a

# Files generated by the build
Makefile
Makefile.*
config.h
config.h.in
configure
configure.ac
aclocal.m4
autom4te.cache/
.libs/
.deps/
config.log
config.nice
config.status
libtool

# Ignore build directories
build/
release/
debug/

# Ignore temporary editor files
*.swp
*.swo
*~

# Test-related files
/tests/*.out
/tests/*.diff
/tests/*.exp
/tests/*.log
/tests/*.php.log
/tests/*.sh.log
# PHPT-generated wrappers (same basename as the .phpt, .sh/.php extension):
/tests/[a-z_]*.php
/tests/[a-z_]*.sh
!/tests/router.php
!/tests/slow_router.php
run-tests.php
/php_test_results_*.txt

# System-specific files
.DS_Store
Thumbs.db
mesi.dep
